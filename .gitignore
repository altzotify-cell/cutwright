# Cutwright -- what is NOT in this repo
#
# Cutwright is mostly glue around two published binaries and a model. All three
# are downloaded by the user, verified against the publisher's own digest, and
# kept out of git: they are 1.2 GB together, and none of them is mine to
# redistribute. PROVENANCE.md records the exact URLs, sizes and sha256s.
#
# Each one is optional at runtime. `cutwright doctor` reports what is missing and
# what stops working without it -- probe/subs/transcribe need whisper, build
# needs Shotcut's melt.

# Shotcut 26.9.27 portable, 4633 files / 522 MB. Provides melt.exe (the renderer
# and the source of truth for filter, transition and producer names).
/shotcut/

# whisper.cpp weights. ggml-small.en.bin alone is 465 MB.
/models/

# whisper.cpp Windows build (whisper-cli.exe + DLLs) plus the .zip it came from.
/bin/

# Source footage. 35 MB for the one clip the demo cuts from, and it is not mine
# to publish -- rebuild any plan against your own footage instead.
/testclips/

# Transcripts, cached melt query results, extracted frames, scratch renders.
/out/

# --- generated by `build` ----------------------------------------------------
# Proof renders, reference windows and frame dumps. Recreated by re-running the
# build; the numbers they produce are kept in checks.json and digest.txt.
/projects/*/check/

# --- python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/dist/

# --- secrets and local overrides ---------------------------------------------
keys.env
.env
*.key
*.pem
*.local.json

# --- os / editor -------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
