        "border": {
            "id": 82,
            "label": "Border",
            "category": "style",
            "summary": "Draws a coloured frame around the picture. wa is the border width in pixels and c0-c5 are the per-edge colour channels; the shipped default is a red frame.",
            "anonymous": false,
            "params": [
                { "key": "pf", "type": "int", "wrap": false, "default": 5 },
                { "key": "lt", "type": "int", "wrap": false, "default": 3000 },
                { "key": "r", "type": "float", "wrap": true, "default": 255, "min": 0, "max": 255 },
                { "key": "g", "type": "float", "wrap": true, "default": 0, "min": 0, "max": 255 },
                { "key": "b", "type": "float", "wrap": true, "default": 0, "min": 0, "max": 255 },
                { "key": "wa", "type": "float", "wrap": true, "default": 4, "min": 0, "max": 500 },
                { "key": "wf", "type": "float", "wrap": true, "default": 1, "min": 0, "max": 10 },
                { "key": "ftb", "type": "int", "wrap": false, "default": 0 },
