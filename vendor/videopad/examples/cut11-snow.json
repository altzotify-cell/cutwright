{
    "template": "probe.vpj",
    "output": "../out/cut11-snow.vpj",
    "sequenceName": "Snow Test",
    "media": [
        { "id": "bars", "path": "../out/testmedia/bars.mp4" }
    ],
    "segments": [
        { "source": "bars", "start": 0, "end": 2000 },
        {
            "source": "bars", "start": 0, "end": 2000,
