        {
            "source": "bars", "start": 0, "end": 2000,
            "effects": [ { "name": "snow", "params": { "pf": 100 } } ]
        },
        {
            "source": "bars", "start": 0, "end": 2000,
            "effects": [ { "name": "snow", "params": { "scale": 0.1 } } ]
        },
        {
            "source": "bars", "start": 0, "end": 2000,
            "effects": [ { "name": "snow", "params": { "scale": 2 } } ]
        },
        {
            "source": "bars", "start": 0, "end": 2000,
            "effects": [ { "name": "snow", "params": { "opacity": 0.3 } } ]
        },
        {
            "source": "bars", "start": 0, "end": 2000,
            "effects": [ { "name": "snow", "params": { "dv": 1 } } ]
        },
        {
            "source": "bars", "start": 0, "end": 2000,
            "effects": [ { "name": "snow", "params": { "lt": 500 } } ]
